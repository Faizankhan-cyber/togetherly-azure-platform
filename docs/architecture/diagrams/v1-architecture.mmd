flowchart TB
    USER(["User / Browser"])

    subgraph AZURE["MICROSOFT AZURE"]
        subgraph RG["Resource Group: rg-togetherly-platform"]
            PUBLIC["Azure Public IP / DNS"]
            NSG["Network Security Group"]
            subgraph VNET["vnet-togetherly-platform"]
                subgraph SUBNET["snet-app: 10.10.1.0/24"]
                    VM["Ubuntu VM: vm-togetherly-v1"]
                    NGINX["Nginx: TLS + Reverse Proxy"]
                    FRONTEND["React + Vite Static Frontend"]
                    API["Node.js Express TinyFish API<br/>127.0.0.1:3001<br/>systemd service"]
                end
            end
        end
    end

    subgraph EXTERNAL["EXTERNAL SERVICES"]
        SUPABASE[("Supabase Auth + PostgreSQL")]
        TINYFISH["TinyFish API"]
    end

    USER -->|"HTTPS 443"| PUBLIC
    PUBLIC --> NSG
    NSG -->|"Allowed inbound traffic"| VM
    VM --> NGINX
    NGINX -->|"Static assets"| FRONTEND
    NGINX -->|"/api/tinyfish/*"| API
    API -->|"HTTPS: session validation and data access"| SUPABASE
    API -->|"HTTPS: server-side API key"| TINYFISH
    API -->|"API response"| NGINX

    NOTE["Azure Functions was proposed but not deployed in V1"]
    NOTE -.-> API
